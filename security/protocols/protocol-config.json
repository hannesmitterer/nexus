{
  "protocol_version": "1.0",
  "security_policy": {
    "name": "Nexus Strict Security",
    "description": "Enhanced security policy with QUIC and TLS 1.3",
    "enabled": true
  },
  "tls_configuration": {
    "minimum_version": "TLSv1.3",
    "maximum_version": "TLSv1.3",
    "cipher_suites": [
      "TLS_AES_256_GCM_SHA384",
      "TLS_CHACHA20_POLY1305_SHA256",
      "TLS_AES_128_GCM_SHA256"
    ],
    "prefer_server_ciphers": true,
    "session_cache": {
      "enabled": true,
      "timeout_minutes": 10,
      "size_mb": 10
    },
    "session_tickets": false,
    "ocsp_stapling": true
  },
  "quic_configuration": {
    "enabled": true,
    "version": "h3",
    "retry_enabled": true,
    "early_data": false,
    "max_idle_timeout_ms": 30000,
    "max_udp_payload_size": 1350,
    "initial_max_data": 10485760,
    "initial_max_stream_data_bidi_local": 1048576,
    "initial_max_stream_data_bidi_remote": 1048576,
    "initial_max_stream_data_uni": 1048576,
    "initial_max_streams_bidi": 100,
    "initial_max_streams_uni": 100
  },
  "http_configuration": {
    "http2_enabled": true,
    "http3_enabled": true,
    "redirect_http_to_https": true,
    "hsts": {
      "enabled": true,
      "max_age_seconds": 63072000,
      "include_subdomains": true,
      "preload": true
    }
  },
  "security_headers": {
    "X-Frame-Options": "DENY",
    "X-Content-Type-Options": "nosniff",
    "X-XSS-Protection": "1; mode=block",
    "Referrer-Policy": "no-referrer-when-downgrade",
    "Content-Security-Policy": "default-src 'self' https:; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline';",
    "Permissions-Policy": "geolocation=(), microphone=(), camera=()"
  },
  "rate_limiting": {
    "enabled": true,
    "api_requests_per_second": 10,
    "burst_size": 10,
    "connection_limit_per_ip": 20
  },
  "certificate_configuration": {
    "cert_path": "/etc/nexus/ssl/cert.pem",
    "key_path": "/etc/nexus/ssl/key.pem",
    "ca_path": "/etc/nexus/ssl/ca.pem",
    "client_verification": "optional",
    "auto_renewal": true
  },
  "firewall_rules": {
    "allow_ports": [443, 8443],
    "block_ports": [80],
    "allow_protocols": ["TCP", "UDP"],
    "geo_blocking": {
      "enabled": false,
      "blocked_countries": []
    }
  },
  "logging": {
    "access_log": "/var/log/nexus/protocol-access.log",
    "error_log": "/var/log/nexus/protocol-error.log",
    "log_level": "info",
    "log_tls_handshakes": true
  },
  "monitoring": {
    "prometheus_metrics": true,
    "metrics_port": 9100,
    "health_check_endpoint": "/health"
  }
}
