# Deployment Configuration for Universal Liquidity Pool (ULP)

# ============ Network Configuration ============

# Polygon Mainnet RPC URL (required for mainnet deployment)
# Get from: https://polygon.technology/developers or Alchemy/Infura
POLYGON_RPC_URL=https://polygon-rpc.com

# Polygon Mumbai Testnet RPC URL (required for testnet deployment)
MUMBAI_RPC_URL=https://rpc-mumbai.maticvigil.com

# ============ Wallet Configuration ============

# Deployer wallet private key (KEEP THIS SECURE!)
# Must have sufficient MATIC for gas fees
# WARNING: Never commit this file with actual private keys
DEPLOYER_PRIVATE_KEY=your_private_key_here

# ============ Contract Addresses ============

# SAIN Token contract address
# Mainnet: TBD after SAIN token deployment
# Testnet: Deploy test token or use existing address
SAIN_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000

# Stablecoin (USDC) address
# Polygon Mainnet USDC: 0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174
# Mumbai Testnet USDC: 0x0FA8781a83E46826621b3BC094Ea2A0212e71B23
STABLECOIN_ADDRESS=0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174

# GGC Multisig wallet address (7/9 configuration)
# This address will control governance functions
GGC_MULTISIG_ADDRESS=0x0000000000000000000000000000000000000000

# ============ Verification Configuration ============

# Polygonscan API Key (for contract verification)
# Get from: https://polygonscan.com/myapikey
POLYGONSCAN_API_KEY=your_polygonscan_api_key_here

# ============ Deployment Parameters ============

# Initial stabilization fee (in basis points, 5-10 allowed)
# Default: 5 (0.05%)
INITIAL_STABILIZATION_FEE=5

# Initial TRE pledge rate (in basis points)
# Default: 30 (0.3%)
INITIAL_TRE_PLEDGE_RATE=30

# ============ Gas Configuration ============

# Gas price in gwei (optional, uses network default if not set)
# GAS_PRICE=50

# Gas limit for deployment (optional)
# GAS_LIMIT=5000000
