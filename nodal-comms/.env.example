# Nodal Communication Configuration

# Kafka Configuration
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=nexus-node

# gRPC Configuration
GRPC_SERVER_PORT=50051
GRPC_SERVER_ADDRESS=localhost:50051

# API Server Configuration
API_SERVER_PORT=3000

# LexAmoris Integration
LEXAMORIS_ENDPOINT=http://localhost:4000
LEXAMORIS_GRPC_ADDRESS=localhost:50052

# Node Configuration
NODE_ID=nexus-primary-node
NODE_ENVIRONMENT=production

# Logging
LOG_LEVEL=info

# Security (Production values should be set in environment)
ENABLE_TLS=false
TLS_CERT_PATH=
TLS_KEY_PATH=
